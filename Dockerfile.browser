# agent-team-browser — a persistent, logged-in browser for one project's
# agents, with a live view the user can take over (docs/BROWSER-TAKEOVER.md).
#
# Chromium (headful, virtual display) with a profile on a volume, the
# Playwright MCP server (HTTP, port 8931) driving it over CDP on loopback,
# and a noVNC live view (port 6080). The entrypoint locks the container's
# own network down (iptables) before it drops to uid 1000: pages can reach
# the internet but no private address, and only the configured subnets may
# connect in.
FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      chromium xvfb x11vnc novnc websockify iptables tini procps \
      fonts-dejavu-core fonts-noto-core fonts-noto-color-emoji ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g --no-fund --no-audit @playwright/mcp@0.0.83

# node:*-slim already has uid 1000 ("node"); the profile lives in /profile.
RUN mkdir -p /profile && chown 1000:1000 /profile
COPY tools/browser-entrypoint.sh /usr/local/bin/browser-entrypoint.sh
RUN chmod 755 /usr/local/bin/browser-entrypoint.sh

ENV DISPLAY=:99 LANG=de_DE.UTF-8 TZ=Europe/Berlin
EXPOSE 8931 6080
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/browser-entrypoint.sh"]
